# Private runtime configuration. Replace placeholders, chmod 600.
AGENT_PROTOCOL=none
PIKOO_VOICE_PROVIDER=openai-live
OPENAI_API_KEY=REPLACE_LOCALLY_DO_NOT_COMMIT
HOST=127.0.0.1
PORT=3101
QWEN_AUDIO_AGENT_ALLOWED_ORIGINS=https://YOUR_HOST
QWEN_AUDIO_MEMORY_AUTO=on
QWEN_AUDIO_SESSION_DIGEST=on
QWEN_AUDIO_WEB_TOOLS_ENABLED=on
QWEN_AUDIO_WEB_SEARCH_PROVIDER=none
DEEPSEEK_API_KEY=REPLACE_LOCALLY_DO_NOT_COMMIT
QWEN_AUDIO_NOTES_TOOL_ENABLED=on
QWEN_AUDIO_RECALL_TOOL_ENABLED=on
QWEN_AUDIO_KNOWLEDGE_TOOL_ENABLED=off
QWEN_AUDIO_SCHEDULE_TOOL_ENABLED=off
QWEN_AUDIO_AGENT_REMINDER_SCHEDULER=false
QWEN_AUDIO_PREFERENCE_LEARNING=off
QWEN_AUDIO_AGENT_SESSION_TTL_MS=86400000
QWEN_AUDIO_LOG_LEVEL=info
QWEN_AUDIO_LOG_MAX_BYTES=5242880
QWEN_AUDIO_LOG_MAX_FILES=3
PIKOO_MEMORY_TIMEOUT_MS=45000
PIKOO_LIVE_VOICE=marin
PIKOO_LIVE_OUTPUT_GAIN_DB=12
PIKOO_COMPANION_MODE=on
