[Unit]
Description=Pikoo device TLS CONNECT proxy
Wants=network-online.target
After=network-online.target pikoo-firewall.service mihomo.service
[Service]
ExecStart=/usr/local/bin/mihomo -d /var/lib/mihomo-device -f /etc/mihomo/device.json
Environment=SAFE_PATHS=/etc/letsencrypt
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
