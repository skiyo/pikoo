# Merge this into the existing Mihomo config. Replace every REPLACE_* value.
# Place the two edge-specific rules before general OpenAI or MATCH rules.
listeners:
  - name: pikoo-edge
    type: http
    listen: 0.0.0.0
    port: 8443
    certificate: /etc/letsencrypt/live/REPLACE_CERT_HOST/fullchain.pem
    private-key: /etc/letsencrypt/live/REPLACE_CERT_HOST/privkey.pem
    users:
      - username: pikoo-device
        password: REPLACE_UNIQUE_PROXY_PASSWORD

rules:
  - AND,((IN-NAME,pikoo-edge),(DOMAIN,api.openai.com),(DST-PORT,443)),REPLACE_OPENAI_OUTBOUND
  - IN-NAME,pikoo-edge,REJECT
  # Append the existing rules below.
