# Merge into a protected environment file loaded BEFORE host.mjs starts.
# Requires the continuous-audio firmware/simulator. No automatic fallback.
PIKOO_VOICE_PROVIDER=openai-live
OPENAI_API_KEY=REPLACE_LOCALLY_DO_NOT_COMMIT
AGENT_PROTOCOL=none
QWEN_AUDIO_MEMORY_AUTO=on
QWEN_AUDIO_SESSION_DIGEST=on
PIKOO_MEMORY_TIMEOUT_MS=45000
# Keep existing owner, authentication, origins, notes and retrieval settings.
